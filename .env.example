# DentalFlow — required environment variables.
#
# This file documents every variable the app and its scripts read. It
# holds no real values — copy it to .env.local and fill in real ones
# there (.env.local is gitignored; never commit real credentials).
#
# See docs/ENVIRONMENTS.md for what "production" vs "staging" means for
# each of these and which Supabase project each one should point at.

# ---- App runtime (production Supabase project) ----------------------
# The app (npm run dev / npm run build) reads these directly. Today
# there is only one configured project, so local development runs
# against the SAME database as production — see docs/ENVIRONMENTS.md
# for why that matters and what to do about it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection to the same project (used by scripts, not
# by the Next.js app itself).
SUPABASE_DB_URL=

NEXT_PUBLIC_APP_URL=

# ---- Email --------------------------------------------------------
RESEND_API_KEY=
INVITATION_FROM_EMAIL=

# ---- Error tracking -------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# ---- Disaster-recovery restore drills AND staging (same isolated ----
# ---- Supabase project — see docs/ENVIRONMENTS.md) --------------------
# A project genuinely distinct from production, live-verified via
# Postgres system_identifier before every use (scripts/backup/lib/env.mjs
# assertDistinctProjects). Never holds real patient/financial data for
# more than the duration of a DR drill (wiped clean afterward); the
# staging schema-sync workflow never writes real data to it at all.
RESTORE_TEST_DB_URL=
RESTORE_TEST_SUPABASE_URL=
RESTORE_TEST_SUPABASE_SERVICE_ROLE_KEY=

# ---- Backup destination (Cloudflare R2) ------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ---- Backup encryption ------------------------------------------------
# 32 bytes, base64-encoded. See docs/DISASTER_RECOVERY.md §4 for the key
# storage/recovery policy — never record the real value anywhere but
# .env.local, the GitHub Actions secret, and the independent recovery
# vault.
BACKUP_ENCRYPTION_KEY=

# ---- Unused — safe to remove -----------------------------------------
# Left over from the AI receptionist feature (removed). No code in this
# repository reads it as of this file's last update.
# OPENAI_API_KEY=
