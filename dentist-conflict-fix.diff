diff --git a/services/appointments.ts b/services/appointments.ts
index 1889a39..0e04da1 100644
--- a/services/appointments.ts
+++ b/services/appointments.ts
@@ -190,6 +190,81 @@ interface CreateAppointmentData {
   treatment: string;
   notes?: string;
   status?: string;
+  duration?: number;
+}
+
+function timeToMinutes(time: string): number {
+  const [h, m] = time.split(":").map(Number);
+  return h * 60 + m;
+}
+
+export class AppointmentConflictError extends Error {
+  constructor(
+    message = "This dentist already has an appointment within 1 hour 30 minutes of that time."
+  ) {
+    super(message);
+    this.name = "AppointmentConflictError";
+  }
+}
+
+/**
+ * Returns true if the dentist has another active (non-cancelled) appointment
+ * on the same date whose time range overlaps [startTime, startTime+duration).
+ * excludeId lets updateAppointment ignore the appointment being edited.
+ */
+async function hasDentistConflict(params: {
+  clinicId: string;
+  dentistId: string;
+  date: string;
+  time: string;
+  duration: number;
+  excludeId?: string;
+}): Promise<boolean> {
+  const {
+    clinicId,
+    dentistId,
+    date,
+    time,
+    duration,
+    excludeId,
+  } = params;
+
+  let query = supabase
+    .from("appointments")
+    .select("id, appointment_time, duration, status")
+    .eq("clinic_id", clinicId)
+    .eq("dentist_id", dentistId)
+    .eq("appointment_date", date)
+    .neq("status", "Cancelled");
+
+  if (excludeId) {
+    query = query.neq("id", excludeId);
+  }
+
+  const { data, error } = await query;
+
+  if (error) {
+    console.error(
+      "Failed to check appointment conflicts:",
+      error
+    );
+    // Fail closed on the check itself failing would block legitimate bookings,
+    // so we let the caller proceed rather than throw here.
+    return false;
+  }
+
+  const newStart = timeToMinutes(time);
+  const newEnd = newStart + duration;
+
+  return (data ?? []).some((existing) => {
+    const existingStart = timeToMinutes(
+      existing.appointment_time
+    );
+    const existingEnd =
+      existingStart + (existing.duration ?? 90);
+
+    return newStart < existingEnd && existingStart < newEnd;
+  });
 }
 
